# ── Phusion Passenger (All-Inkl Python) ──────────────────────────────────────
PassengerEnabled On
PassengerAppRoot /www/htdocs/w015c898/homelab-control.com
PassengerStartupFile passenger_wsgi.py
PassengerAppType wsgi
PassengerPython /usr/bin/python3

# ── Erste Sicherheitsschicht: HTTP Basic Auth ─────────────────────────────────
# AuthType Basic
# AuthName "Homelab – Zugang gesperrt"
# AuthUserFile /www/htdocs/w015c898/homelab-control.com/.htpasswd
# Require valid-user

# ── Security-Header ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
</IfModule>

# ── Statische Dateien direkt ausliefern (Performance) ────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Statische Assets direkt servieren
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ui/(.*)$ ui/$1 [L]

    # Health-Check ohne Auth (optional, für Monitoring)
    # RewriteRule ^health$ - [L]
</IfModule>

# ── Verzeichnis-Listing verbieten ─────────────────────────────────────────────
Options -Indexes

# ── Sensible Dateien sperren ──────────────────────────────────────────────────
<FilesMatch "\.(env|log|yml|yaml|py|pyc)$">
    Order allow,deny
    Deny from all
</FilesMatch>
