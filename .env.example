# ── API Security ──────────────────────────────────────────────────────────────
# Token-Hash erzeugen:
# python3 -c "import hashlib; print(hashlib.sha256(b'DEIN-SICHERES-TOKEN').hexdigest())"
API_TOKEN_HASH=CHANGE_ME

# ── Hosts ─────────────────────────────────────────────────────────────────────
MINI_PC_HOST=mini-pc.local
LLM_LOCAL_HOST=llm-pc.local

# ── Wake-on-LAN ───────────────────────────────────────────────────────────────
LLM_MAC=AA:BB:CC:DD:EE:FF

# ── Node Exporter Endpoints ───────────────────────────────────────────────────
LLM_NODE_EXPORTER=192.168.1.20:9100
MINIPC_NODE_EXPORTER=192.168.1.10:9100

# ── GPU Exporter (nvidia-smi Exporter) ───────────────────────────────────────
LLM_GPU_EXPORTER=192.168.1.20:9400
