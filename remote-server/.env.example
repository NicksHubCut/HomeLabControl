# ── Mini-PC API (Tailscale Funnel) ───────────────────────────────────────────
# tailscale funnel status → zeigt die öffentliche URL
MINIPC_API=https://HOSTNAME.TAILNET.ts.net

# ── API-Token ────────────────────────────────────────────────────────────────
# Gleiches Token wie LOCAL_API_TOKEN in local-server/.env
MINIPC_TOKEN=HIER_TOKEN_EINTRAGEN

# ── Wake-on-LAN MAC-Adressen ─────────────────────────────────────────────────
# Service-Name aus services.json, Bindestriche → Unterstriche, alles groß + _MAC
# mini-pc    → MINI_PC_MAC
# llm-server → LLM_SERVER_MAC
MINI_PC_MAC=HIER_MINIPC_MAC_EINTRAGEN
LLM_SERVER_MAC=HIER_LLM_MAC_EINTRAGEN
