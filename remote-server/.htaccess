# ── Basic Auth (erste Sicherheitsschicht) ─────────────────────────────────────
AuthType Basic
AuthName "Homelab Control"
AuthUserFile /www/htdocs/w015c898/homelab-control.com/.htpasswd
Require valid-user
# homelab:Homelab_55442266!

# ── Routing ───────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Health ohne Prefix direkt zur API
    RewriteRule ^health$ api.php [L,QSA]

    # Alle /api/* Requests → api.php
    RewriteRule ^api/(.*)$ api.php [L,QSA]

    # Existierende Dateien direkt ausliefern (index.html, assets etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Root → index.html
    RewriteRule ^$ index.html [L]
</IfModule>

# ── Security ──────────────────────────────────────────────────────────────────
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sensible Dateien sperren
<FilesMatch "\.(env|log|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# services.json explizit sperren
<Files "services.json">
    Order allow,deny
    Deny from all
</Files>
